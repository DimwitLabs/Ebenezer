# Bundled database (docker-compose.yml). Letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=

# Your own database instead (docker-compose.external-db.yml), such as Supabase.
# Poolers work; use sslmode=require or verify-full.
EBENEZER_DATABASE_URL=

# Seals the keys and passwords saved in Settings. Lose it and they must be entered again: openssl rand -base64 32
EBENEZER_ENCRYPTION_KEY=

# Optional. Where people reach this Ebenezer, e.g. https://ebenezer.example.com, for links in emails.
EBENEZER_PUBLIC_URL=

# Run the price, news and health schedules. Turn off on all but one copy if you run several.
EBENEZER_SCHEDULER=true
# The clock schedule times are written in. Market days still follow the exchanges.
TZ=Asia/Kolkata

# false only for local testing over plain HTTP
EBENEZER_SECURE_COOKIES=true
EBENEZER_SESSION_HOURS=336

EBENEZER_BIND=127.0.0.1
EBENEZER_PORT=8080
